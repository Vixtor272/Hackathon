{
  "name": "farmi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Farmi · Farmaenlace — Svelte frontend: app del cliente (WhatsApp, checkout, DeUna) y portal de la empresa (caja, reparto)",
  "scripts": {
    "dev": "vite",
    "dev:empresa": "vite --config vite.empresa.config.ts",
    "build": "vite build && vite build --config vite.empresa.config.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  }
}
